# Copy to .env.local if you need overrides. Never commit real secrets.

# Sign-in is on by default (Google + X via the app's Better Auth route).
# Set to false only to disable authentication.
# VITE_AUTH_ENABLED=true

# Postgres. If unset, the app uses a local PGLite fallback.
# DATABASE_URL=postgres://user:pass@host:5432/caliper

# Optional xAI API for in-app AI features (server-only).
# XAI_API_KEY=
