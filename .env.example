# Copy to .env.local if you need overrides. Never commit real secrets.

# Sign-in (email + password, handled by the app's own Better Auth route) is on
# by default. Set to false only to disable authentication.
# VITE_AUTH_ENABLED=true

# Postgres. If unset, the app uses a local PGLite fallback that a restart wipes.
# DATABASE_URL=postgres://user:pass@host:5432/instrument

# Public URL of the deployed app. Set this in production so session cookies and
# trusted origins resolve to the real origin.
# BETTER_AUTH_URL=https://your-app.example.com

# Signing secret for sessions in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=

# Comma-separated emails allowed to read shared admin data (the Feedback inbox).
# Matched against the verified session email. Unset means nobody — sign-up is
# open, so "signed in" is not by itself permission to read other people's
# messages.
# ADMIN_EMAILS=you@example.com

# Optional xAI API for in-app AI features (server-only).
# XAI_API_KEY=
