# Copy to .env.local if you need overrides. Never commit real secrets.

# Sign-in (email + password, handled by the app's own Better Auth route) is on
# by default. Set to false only to disable authentication.
# VITE_AUTH_ENABLED=true

# Postgres. If unset, the app uses a local PGLite fallback that a restart wipes.
# DATABASE_URL=postgres://user:pass@host:5432/instrument

# Public URL of the deployed app. Set this in production so session cookies and
# trusted origins resolve to the real origin.
# BETTER_AUTH_URL=https://your-app.example.com

# Signing secret for sessions in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=

# Comma-separated emails allowed to read shared admin data (the Feedback inbox).
# Matched against the verified session email. Unset means nobody — sign-up is
# open, so "signed in" is not by itself permission to read other people's
# messages.
# ADMIN_EMAILS=you@example.com


# Optional. Enables "Draft from a description" in Studio, which asks a model for
# a calculator draft. Absent key, absent feature — nothing else changes.
# Each draft spends on this key, so the endpoint is sign-in only and capped at
# 10 drafts per account per hour. Drafts are labelled as drafted and never
# publish themselves.
#
# Set one key. Both providers stay wired, so switching is this file, not code.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# Only needed to break a tie when both keys are set, or to be explicit. Named
# but keyless means drafting reports itself unconfigured rather than quietly
# billing the other account.
# AI_PROVIDER=openai
#
# Optional overrides. Which models an account can reach differs per account,
# so the shipped defaults (gpt-5 / claude-opus-5) may need naming explicitly.
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
